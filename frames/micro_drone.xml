<mujoco model="custom_drone">
    <compiler angle="degree" coordinate="local" eulerseq="xyz"/>
    <option timestep="0.002" gravity="0 0 -9.81"/>
    
    <custom>
        <numeric name="transport_delay_ms" data="10.0"/>
        <numeric name="motor_tau" data="0.015"/>
        <numeric name="dof_mask" data="0 0 1 1 1 1"/>
    </custom>
    
    <worldbody>
        <light name="sun" pos="0 0 10" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="10 10 0.1" rgba="0.8 0.9 0.8 1"/>
        
        <body name="drone" pos="0 0 1">
            <freejoint name="root"/>
            
            <!-- Core -->
            <geom name="core" type="box" size="0.03 0.03 0.01" mass="0.08" rgba="0.2 0.3 0.8 1"/>

            <!-- Motor 0: 2" CCW (Force: 2N, Cant: 0, 0) -->
            <body name="motor_assembly_0" pos="0 0 0">
                <geom name="arm_0" type="capsule" fromto="0 0 0 0.04 0.04 0" size="0.005" mass="0.011" rgba="0.5 0.5 0.5 1"/>
                <body name="motor_mount_0" pos="0.04 0.04 0.005" euler="0 0 0">
                    <geom name="motor_bell_0" type="cylinder" size="0.015 0.005" mass="0.03" rgba="0.2 0.2 0.2 1"/>
                    <site name="thruster_0" type="cylinder" pos="0 0 0.005" size="0.025 0.002" rgba="1 0 0 0.5"/>
                </body>
            </body>

            <!-- Motor 1: 2" CW (Force: 2N, Cant: 0, 0) -->
            <body name="motor_assembly_1" pos="0 0 0">
                <geom name="arm_1" type="capsule" fromto="0 0 0 0.04 -0.04 0" size="0.005" mass="0.011" rgba="0.5 0.5 0.5 1"/>
                <body name="motor_mount_1" pos="0.04 -0.04 0.005" euler="0 0 0">
                    <geom name="motor_bell_1" type="cylinder" size="0.015 0.005" mass="0.03" rgba="0.2 0.2 0.2 1"/>
                    <site name="thruster_1" type="cylinder" pos="0 0 0.005" size="0.025 0.002" rgba="0 0 1 0.5"/>
                </body>
            </body>

            <!-- Motor 2: 2" CW (Force: 2N, Cant: 0, 10) -->
            <body name="motor_assembly_2" pos="0 0 0">
                <geom name="arm_2" type="capsule" fromto="0 0 0 -0.04 0.04 0" size="0.005" mass="0.011" rgba="0.5 0.5 0.5 1"/>
                <body name="motor_mount_2" pos="-0.04 0.04 0.005" euler="0 10 0">
                    <geom name="motor_bell_2" type="cylinder" size="0.015 0.005" mass="0.03" rgba="0.2 0.2 0.2 1"/>
                    <site name="thruster_2" type="cylinder" pos="0 0 0.005" size="0.025 0.002" rgba="1 0 0 0.5"/>
                </body>
            </body>

            <!-- Motor 3: 2" CCW (Force: 2N, Cant: 0, 10) -->
            <body name="motor_assembly_3" pos="0 0 0">
                <geom name="arm_3" type="capsule" fromto="0 0 0 -0.04 -0.04 0" size="0.005" mass="0.011" rgba="0.5 0.5 0.5 1"/>
                <body name="motor_mount_3" pos="-0.04 -0.04 0.005" euler="0 10 0">
                    <geom name="motor_bell_3" type="cylinder" size="0.015 0.005" mass="0.03" rgba="0.2 0.2 0.2 1"/>
                    <site name="thruster_3" type="cylinder" pos="0 0 0.005" size="0.025 0.002" rgba="0 0 1 0.5"/>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <general name="m_0" site="thruster_0" gear="0 0 1 0 0 0.0015" ctrllimited="true" ctrlrange="0 2.0"/>
        <general name="m_1" site="thruster_1" gear="0 0 1 0 0 -0.0015" ctrllimited="true" ctrlrange="0 2.0"/>
        <general name="m_2" site="thruster_2" gear="0 0 1 0 0 -0.0015" ctrllimited="true" ctrlrange="0 2.0"/>
        <general name="m_3" site="thruster_3" gear="0 0 1 0 0 0.0015" ctrllimited="true" ctrlrange="0 2.0"/>
    </actuator>
</mujoco>