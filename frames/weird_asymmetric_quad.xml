<mujoco model="weird_asymmetric_quad">
    <compiler angle="degree" coordinate="local" eulerseq="xyz"/>
    <option timestep="0.002" gravity="0 0 -9.81"/>
    
    <custom>
        <numeric name="transport_delay_ms" data="10.0"/>
        <numeric name="motor_tau" data="0.015"/>
        <numeric name="dof_mask" data="0 0 1 1 1 1"/>
    </custom>
    
    <worldbody>
        <light name="sun" pos="0 0 10" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="10 10 0.1" rgba="0.8 0.9 0.8 1"/>
        
        <body name="drone" pos="0 0 1">
            <freejoint name="root"/>
            <!-- Slightly offset center of mass to make it even harder -->
            <inertial pos="-0.02 -0.01 0" mass="0.65" diaginertia="0.0025 0.003 0.005"/>
            <geom name="core" type="box" size="0.06 0.04 0.02" rgba="0.2 0.3 0.8 1"/>
            
            <!-- Motor 0: Front Right (Closer, 7 inch) -->
            <!-- Pos: x=0.05, y=0.03 -->
            <body name="arm_0" pos="0.05 0.03 0.0">
                <geom type="capsule" size="0.005 0.04" rgba="0.5 0.5 0.5 1" euler="90 30 0"/>
                <site name="thruster_0" pos="0 0 0.01" type="cylinder" size="0.035 0.005" rgba="1 0.2 0 1"/>
            </body>
            
            <!-- Motor 1: Front Left (Closer, 7 inch) -->
            <!-- Pos: x=0.04, y=-0.04 (asymmetric layout) -->
            <body name="arm_1" pos="0.04 -0.04 0.0">
                <geom type="capsule" size="0.005 0.04" rgba="0.5 0.5 0.5 1" euler="90 -45 0"/>
                <site name="thruster_1" pos="0 0 0.01" type="cylinder" size="0.035 0.005" rgba="1 0.2 0 1"/>
            </body>
            
            <!-- Motor 2: Rear Left (Further, 5 inch) -->
            <!-- Pos: x=-0.12, y=-0.08 -->
            <body name="arm_2" pos="-0.12 -0.08 0.0">
                <geom type="capsule" size="0.005 0.07" rgba="0.5 0.5 0.5 1" euler="90 33 0"/>
                <site name="thruster_2" pos="0 0 0.01" type="cylinder" size="0.025 0.005" rgba="0 0.8 0 1"/>
            </body>
            
            <!-- Motor 3: Rear Right (Further, 6 inch) -->
            <!-- Pos: x=-0.10, y=0.11 -->
            <body name="arm_3" pos="-0.10 0.11 0.0">
                <geom type="capsule" size="0.005 0.06" rgba="0.5 0.5 0.5 1" euler="90 -48 0"/>
                <site name="thruster_3" pos="0 0 0.01" type="cylinder" size="0.030 0.005" rgba="0 0.2 1 1"/>
            </body>
        </body>
    </worldbody>
    
    <actuator>
        <!-- Gear Array: [ForceX, ForceY, ForceZ, TorqueX, TorqueY, TorqueZ] -->
        <!-- Front 7-inch: higher thrust (0-16), higher drag (~0.02) -->
        <general name="m_0" site="thruster_0" gear="0 0 1 0 0 -0.02" ctrllimited="true" ctrlrange="0 16"/>
        <general name="m_1" site="thruster_1" gear="0 0 1 0 0  0.02" ctrllimited="true" ctrlrange="0 16"/>
        
        <!-- Rear Left 5-inch: lower thrust (0-9), lower drag (~0.01) -->
        <general name="m_2" site="thruster_2" gear="0 0 1 0 0 -0.01" ctrllimited="true" ctrlrange="0 9"/>
        
        <!-- Rear Right 6-inch: med thrust (0-12), med drag (~0.015) -->
        <general name="m_3" site="thruster_3" gear="0 0 1 0 0  0.015" ctrllimited="true" ctrlrange="0 12"/>
    </actuator>
</mujoco>
