    <plugin name="drone_optimizer_mjcf" filename="dummy.so">
      <mujoco_xml>
<mujoco model="LargeQuad">
    <compiler angle="degree" coordinate="local" eulerseq="xyz"/>
    <option timestep="0.002" gravity="0 0 -9.81"/>
    
    <custom>
        <numeric name="transport_delay_ms" data="10.0"/>
        <numeric name="motor_tau" data="0.08"/>
        <numeric name="sim_duration_s" data="6.0"/>
        <numeric name="dof_mask" data="0 0 1 1 1 1"/>
    </custom>
    
    <worldbody>
        <light name="sun" pos="0 0 10" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="10 10 0.1" rgba="0.8 0.9 0.8 1"/>
        
        <body name="drone" pos="0 0 1">
            <freejoint name="root"/>
            
            <!-- Core -->
            <geom name="core" type="box" size="0.2 0.2 0.1" mass="15" rgba="0.2 0.3 0.8 1"/>

            <!-- Motor 0: 18" CCW (Force: 83.37N, Cant: 0, 0) [Data: 3400 13.27 0.31; 3800 16.72 0.39; 4200 20.61 0.48; 4600 24.92 0.58; 5000 29.69 0.69; 5400 34.88 0.81; 5800 40.50 0.93; 6200 46.56 1.07; 6600 53.05 1.22; 7000 59.98 1.38; 7400 67.34 1.55; 7800 75.14 1.73; 8200 83.37 Unit: N] -->
            <body name="motor_assembly_0" pos="0 0 0">
                <geom name="arm_0" type="capsule" fromto="0 0 0 0.3 0.3 0" size="0.005" mass="0.085" rgba="0.5 0.5 0.5 1"/>
                <body name="motor_mount_0" pos="0.3 0.3 0.005" euler="0 0 0">
                    <geom name="motor_bell_0" type="cylinder" size="0.015 0.005" mass="0.03" rgba="0.2 0.2 0.2 1"/>
                    <geom name="prop_0" type="cylinder" pos="0 0 0.005" size="0.229 0.002" mass="0.0340" rgba="0.1 0.1 0.1 0.3"/>
                    <site name="thruster_0" type="cylinder" pos="0 0 0.005" size="0.229 0.002" rgba="1 0 0 0.5"/>
                </body>
            </body>

            <!-- Motor 1: 18" CW (Force: 83.37N, Cant: 0, 0) [Data: 3400 13.27 0.31; 3800 16.72 0.39; 4200 20.61 0.48; 4600 24.92 0.58; 5000 29.69 0.69; 5400 34.88 0.81; 5800 40.50 0.93; 6200 46.56 1.07; 6600 53.05 1.22; 7000 59.98 1.38; 7400 67.34 1.55; 7800 75.14 1.73; 8200 83.37 Unit: N] -->
            <body name="motor_assembly_1" pos="0 0 0">
                <geom name="arm_1" type="capsule" fromto="0 0 0 0.3 -0.3 0" size="0.005" mass="0.085" rgba="0.5 0.5 0.5 1"/>
                <body name="motor_mount_1" pos="0.3 -0.3 0.005" euler="0 0 0">
                    <geom name="motor_bell_1" type="cylinder" size="0.015 0.005" mass="0.03" rgba="0.2 0.2 0.2 1"/>
                    <geom name="prop_1" type="cylinder" pos="0 0 0.005" size="0.229 0.002" mass="0.0340" rgba="0.1 0.1 0.1 0.3"/>
                    <site name="thruster_1" type="cylinder" pos="0 0 0.005" size="0.229 0.002" rgba="0 0 1 0.5"/>
                </body>
            </body>

            <!-- Motor 2: 18" CW (Force: 83.37N, Cant: 0, 0) [Data: 3400 13.27 0.31; 3800 16.72 0.39; 4200 20.61 0.48; 4600 24.92 0.58; 5000 29.69 0.69; 5400 34.88 0.81; 5800 40.50 0.93; 6200 46.56 1.07; 6600 53.05 1.22; 7000 59.98 1.38; 7400 67.34 1.55; 7800 75.14 1.73; 8200 83.37 Unit: N] -->
            <body name="motor_assembly_2" pos="0 0 0">
                <geom name="arm_2" type="capsule" fromto="0 0 0 -0.3 0.3 0" size="0.005" mass="0.085" rgba="0.5 0.5 0.5 1"/>
                <body name="motor_mount_2" pos="-0.3 0.3 0.005" euler="0 0 0">
                    <geom name="motor_bell_2" type="cylinder" size="0.015 0.005" mass="0.03" rgba="0.2 0.2 0.2 1"/>
                    <geom name="prop_2" type="cylinder" pos="0 0 0.005" size="0.229 0.002" mass="0.0340" rgba="0.1 0.1 0.1 0.3"/>
                    <site name="thruster_2" type="cylinder" pos="0 0 0.005" size="0.229 0.002" rgba="1 0 0 0.5"/>
